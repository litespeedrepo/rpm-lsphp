%{?scl:%scl_package php-pecl-mailparse}

# Define Macros
%global lsapiver %%LSAPIVER%%
%define php_prefix lsphp%%PHP_VER%%
%define debug_package %{nil}

%define _prefix /usr/local/lsws/%{php_prefix}
%define _sysconfdir %{_prefix}/etc
%define _localstatedir %{_prefix}/var
%define _mandir %{_prefix}/share/man
%define _libdir %{_prefix}/%{_lib}
%define _bindir %{_prefix}/bin
%define _datadir %{_prefix}/share
%define macrosdir %{_prefix}/etc/rpm
%define _docdir %{_prefix}/share/doc
%define _includedir %{_prefix}/include

%define php_inidir %{_prefix}/etc/php.d
%define php_extdir %{_libdir}/php/modules
%define php_incldir %{_includedir}/php
%define pecl_xmldir %{_prefix}/share/pear/.pkgxml
%define pecl_testdir %{_prefix}/var/pear
%define pecl_docdir %{_prefix}/share/doc
%define peardir /usr/share/pear

%global __php %{_bindir}/php

%global pecl_name  mailparse
%global extname    mailparse
%global with_zts   0
%global with_test  0
%global ini_name   40-%{extname}.ini

Name:      %{php_prefix}-pecl-%{pecl_name}
Summary:   PHP PECL package for parsing and working with email messages
License:   PHP-3.01
Version:   %%VERSION%%
Release:   1%{?dist}
URL:       https://pecl.php.net/package/mailparse
Source0:   https://pecl.php.net/get/%{extname}-%{version}.tgz

BuildRequires: make
BuildRequires: %{?dtsprefix}gcc
BuildRequires: %{php_prefix}-devel
BuildRequires: %{php_prefix}-pear
BuildRequires: autoconf, automake, libtool

Requires:  %{php_prefix}
Requires:  %{php_prefix}-common

Provides:  %{php_prefix}-%{pecl_name}               = %{version}
Provides:  %{php_prefix}-%{pecl_name}%{?_isa}       = %{version}
Provides:  %{php_prefix}-pecl(%{pecl_name})         = %{version}
Provides:  %{php_prefix}-pecl(%{pecl_name})%{?_isa} = %{version}

%description
Mailparse is an extension for parsing and working with email messages.
It can deal with rfc822 and rfc2045 (MIME) compliant messages.

Package built for PHP %(%{__php} -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)%{?scl: as Software Collection (%{scl} by %{?scl_vendor}%{!?scl_vendor:rh})}.


%prep
%setup -q -c
mv %{extname}-%{version} NTS
cd NTS

# avoid re2c
touch php_mailparse_rfc822.c

extver=$(sed -n '/#define PHP_MAILPARSE_VERSION/{s/.* "//;s/".*$//;p}' php_mailparse.h)
if test "x${extver}" != "x%{version}"; then
   echo "Error: Upstream version is ${extver}, expecting %{version}."
   exit 1
fi

cd ..

cat > %{ini_name} << 'EOF'
; Enable %{pecl_name} extension module
extension = %{pecl_name}.so

; Set the default charset
;mailparse.def_charset = us-ascii
EOF

%if %{with_zts}
mkdir ZTS
%endif


%build
: Standard NTS build
cd NTS
%{_bindir}/phpize
%configure --with-php-config=%{_bindir}/php-config
%make_build

%if %{with_zts}
cd ../ZTS
: ZTS build
%configure --with-php-config=%{__ztsphpconfig}
%make_build
%endif


%install
%make_install INSTALL_ROOT=%{buildroot} -C NTS

# Drop in the bit of configuration
install -D -m 644 %{ini_name} %{buildroot}%{php_inidir}/%{ini_name}

%if %{with_zts}
%make_install -C ZTS
install -D -m 644 %{ini_name} %{buildroot}%{php_ztsinidir}/%{ini_name}
%endif


%check
cd NTS

: Minimal load test for NTS extension
%{__php} --no-php-ini \
    --define extension_dir=%{buildroot}%{php_extdir} \
    --define extension=%{pecl_name}.so \
    --modules | grep '^%{pecl_name}$'

%if %{with_test}
: Upstream test suite for NTS extension
TEST_PHP_EXECUTABLE=%{__php} \
TEST_PHP_ARGS="-n -d extension=%{buildroot}%{php_extdir}/%{pecl_name}.so" \
%{__php} -n run-tests.php -q --show-diff
%endif

%if %{with_zts}
: Minimal load test for ZTS extension
%{__ztsphp} --no-php-ini \
    --define extension_dir=%{buildroot}%{php_ztsextdir} \
    --define extension=%{pecl_name}.so \
    --modules | grep '^%{pecl_name}$'
%endif


%files

%config(noreplace) %{php_inidir}/%{ini_name}
%{php_extdir}/%{pecl_name}.so

%if %{with_zts}
%config(noreplace) %{php_ztsinidir}/%{ini_name}
%{php_ztsextdir}/%{pecl_name}.so
%endif


%changelog
* Thu Apr  9 2026 Remi Collet <remi@remirepo.net> - 3.2.0-1
- update to 3.2.0
- drop dependency on mbstring

* Tue Mar 17 2026 Remi Collet <remi@remirepo.net> - 3.1.9-2
- drop pear/pecl dependency
- sources from github